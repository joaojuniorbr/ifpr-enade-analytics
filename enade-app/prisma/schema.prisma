generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Dim_Dificuldade {
  DificuldadeKey   Int                @id
  Nivel            String             @unique(map: "Nivel") @db.VarChar(16)
  Dim_Questao_Eixo Dim_Questao_Eixo[]
  Fato_Respostas   Fato_Respostas[]
}

model Dim_Turma {
  TurmaKey          Int                @id
  TurmaGrupo        String             @unique(map: "TurmaGrupo") @db.VarChar(64)
  Dim_Aluno_Anonimo Dim_Aluno_Anonimo[]
  Fato_Respostas    Fato_Respostas[]
}

model Dim_Tempo {
  TempoKey          Int                @id
  Data              DateTime           @unique(map: "Data") @db.Date
  NumeroSimulado    Int
  CodigoSimulado    String             @unique(map: "CodigoSimulado") @db.VarChar(64)
  DescricaoSimulado String             @db.VarChar(255)
  Ano               Int
  Mes               Int
  NomeMes           String             @db.VarChar(20)
  SemanaSemestre    Int
  Fato_Respostas    Fato_Respostas[]
  Simulado_Questoes Simulado_Questao[]
  Tentativas        Tentativa[]
}

model Dim_Questao_Eixo {
  QuestaoEixoKey    Int                @id
  CodigoQuestao     String             @unique(map: "CodigoQuestao") @db.VarChar(32)
  EixoTematico      String             @db.VarChar(128)
  Enunciado         String?            @db.Text
  DificuldadeKey    Int
  Dim_Dificuldade   Dim_Dificuldade    @relation(fields: [DificuldadeKey], references: [DificuldadeKey], onDelete: NoAction, onUpdate: NoAction, map: "Dim_Questao_Eixo_ibfk_1")
  Fato_Respostas    Fato_Respostas[]
  Alternativas      Alternativa[]
  Simulado_Questoes Simulado_Questao[]
  Tentativa_Itens   Tentativa_Item[]

  @@index([EixoTematico], map: "IX_Questao_Eixo")
  @@index([DificuldadeKey], map: "IX_Questao_Dificuldade")
}

model Dim_Aluno_Anonimo {
  AlunoKey           Int              @id
  CodigoAlunoAnonimo String           @unique(map: "CodigoAlunoAnonimo") @db.VarChar(32)
  TurmaKey           Int
  Dim_Turma          Dim_Turma        @relation(fields: [TurmaKey], references: [TurmaKey], onDelete: NoAction, onUpdate: NoAction, map: "Dim_Aluno_Anonimo_ibfk_1")
  Fato_Respostas     Fato_Respostas[]
  Tentativas         Tentativa[]

  @@index([TurmaKey], map: "IX_Aluno_Turma")
}

model Fato_Respostas {
  RespostaKey           Int               @id
  TempoKey              Int
  QuestaoEixoKey        Int
  DificuldadeKey        Int
  TurmaKey              Int
  AlunoKey              Int
  RespostaDada          String            @db.VarChar(8)
  Acertou               Int
  TempoRespostaSegundos Int?
  Dim_Tempo             Dim_Tempo         @relation(fields: [TempoKey], references: [TempoKey], onDelete: NoAction, onUpdate: NoAction, map: "Fato_Respostas_ibfk_1")
  Dim_Questao_Eixo      Dim_Questao_Eixo  @relation(fields: [QuestaoEixoKey], references: [QuestaoEixoKey], onDelete: NoAction, onUpdate: NoAction, map: "Fato_Respostas_ibfk_2")
  Dim_Dificuldade       Dim_Dificuldade   @relation(fields: [DificuldadeKey], references: [DificuldadeKey], onDelete: NoAction, onUpdate: NoAction, map: "Fato_Respostas_ibfk_3")
  Dim_Turma             Dim_Turma         @relation(fields: [TurmaKey], references: [TurmaKey], onDelete: NoAction, onUpdate: NoAction, map: "Fato_Respostas_ibfk_4")
  Dim_Aluno_Anonimo     Dim_Aluno_Anonimo @relation(fields: [AlunoKey], references: [AlunoKey], onDelete: NoAction, onUpdate: NoAction, map: "Fato_Respostas_ibfk_5")

  @@unique([AlunoKey, QuestaoEixoKey, TempoKey], map: "AlunoKey")
  @@index([TempoKey], map: "IX_Fato_Tempo")
  @@index([QuestaoEixoKey], map: "IX_Fato_Questao")
  @@index([DificuldadeKey], map: "IX_Fato_Dificuldade")
  @@index([TurmaKey], map: "IX_Fato_Turma")
  @@index([AlunoKey], map: "IX_Fato_Aluno")
}

model Alternativa {
  AlternativaKey Int              @id @default(autoincrement())
  QuestaoEixoKey Int
  Letra          String           @db.VarChar(1)
  Texto          String           @db.VarChar(1000)
  Correta        Int
  Dim_Questao_Eixo Dim_Questao_Eixo @relation(fields: [QuestaoEixoKey], references: [QuestaoEixoKey], onDelete: Cascade, onUpdate: NoAction, map: "Alternativa_ibfk_1")

  @@unique([QuestaoEixoKey, Letra], map: "UQ_Alternativa_Questao_Letra")
  @@index([QuestaoEixoKey], map: "IX_Alternativa_Questao")
}

model Simulado_Questao {
  TempoKey       Int
  QuestaoEixoKey Int
  Dim_Tempo      Dim_Tempo        @relation(fields: [TempoKey], references: [TempoKey], onDelete: Cascade, onUpdate: NoAction, map: "Simulado_Questao_ibfk_1")
  Dim_Questao_Eixo Dim_Questao_Eixo @relation(fields: [QuestaoEixoKey], references: [QuestaoEixoKey], onDelete: Cascade, onUpdate: NoAction, map: "Simulado_Questao_ibfk_2")

  @@id([TempoKey, QuestaoEixoKey])
  @@index([QuestaoEixoKey], map: "IX_Simulado_Questao_Questao")
}

model Tentativa {
  TentativaKey      Int               @id @default(autoincrement())
  AlunoKey          Int
  TempoKey          Int
  IniciadaEm        DateTime          @default(now())
  FinalizadaEm      DateTime?
  Acertos           Int               @default(0)
  TotalQuestoes     Int
  OrdemQuestoes     String            @db.VarChar(4000)
  Dim_Aluno_Anonimo Dim_Aluno_Anonimo @relation(fields: [AlunoKey], references: [AlunoKey], onDelete: NoAction, onUpdate: NoAction, map: "Tentativa_ibfk_1")
  Dim_Tempo         Dim_Tempo         @relation(fields: [TempoKey], references: [TempoKey], onDelete: NoAction, onUpdate: NoAction, map: "Tentativa_ibfk_2")
  Itens             Tentativa_Item[]

  @@index([AlunoKey, TempoKey], map: "IX_Tentativa_Aluno_Tempo")
  @@index([TempoKey], map: "IX_Tentativa_Tempo")
}

model Tentativa_Item {
  TentativaKey   Int
  QuestaoEixoKey Int
  LetraMarcada   String           @db.VarChar(1)
  Acertou        Int
  Tentativa      Tentativa        @relation(fields: [TentativaKey], references: [TentativaKey], onDelete: Cascade, onUpdate: NoAction, map: "Tentativa_Item_ibfk_1")
  Dim_Questao_Eixo Dim_Questao_Eixo @relation(fields: [QuestaoEixoKey], references: [QuestaoEixoKey], onDelete: NoAction, onUpdate: NoAction, map: "Tentativa_Item_ibfk_2")

  @@id([TentativaKey, QuestaoEixoKey])
  @@index([QuestaoEixoKey], map: "IX_Tentativa_Item_Questao")
}

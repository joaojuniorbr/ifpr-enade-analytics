generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Dim_Aluno_Anonimo {
  AlunoKey           Int              @id
  CodigoAlunoAnonimo String           @unique(map: "CodigoAlunoAnonimo") @db.VarChar(32)
  TurmaGrupo         String           @db.VarChar(64)
  Fato_Respostas     Fato_Respostas[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Dim_Questao {
  QuestaoKey       Int              @id
  CodigoQuestao    String           @unique(map: "CodigoQuestao") @db.VarChar(32)
  EixoTematico     String           @db.VarChar(128)
  NivelDificuldade String           @db.VarChar(16)
  Fato_Respostas   Fato_Respostas[]

  @@index([EixoTematico], map: "IX_Questao_Eixo")
}

model Dim_Simulado {
  SimuladoKey       Int              @id
  CodigoSimulado    String           @unique(map: "CodigoSimulado") @db.VarChar(64)
  NumeroAplicacao   Int
  DescricaoSimulado String           @db.VarChar(255)
  Fato_Respostas    Fato_Respostas[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Dim_Tempo {
  TempoKey       Int              @id
  Data           DateTime         @unique(map: "Data") @db.Date
  Ano            Int
  Mes            Int
  NomeMes        String           @db.VarChar(20)
  SemanaSemestre Int
  Fato_Respostas Fato_Respostas[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Fato_Respostas {
  RespostaKey           Int               @id
  TempoKey              Int
  AlunoKey              Int
  QuestaoKey            Int
  SimuladoKey           Int
  RespostaDada          String            @db.VarChar(8)
  Acertou               Int
  TempoRespostaSegundos Float?
  Dim_Tempo             Dim_Tempo         @relation(fields: [TempoKey], references: [TempoKey], onDelete: NoAction, onUpdate: NoAction, map: "Fato_Respostas_ibfk_1")
  Dim_Aluno_Anonimo     Dim_Aluno_Anonimo @relation(fields: [AlunoKey], references: [AlunoKey], onDelete: NoAction, onUpdate: NoAction, map: "Fato_Respostas_ibfk_2")
  Dim_Questao           Dim_Questao       @relation(fields: [QuestaoKey], references: [QuestaoKey], onDelete: NoAction, onUpdate: NoAction, map: "Fato_Respostas_ibfk_3")
  Dim_Simulado          Dim_Simulado      @relation(fields: [SimuladoKey], references: [SimuladoKey], onDelete: NoAction, onUpdate: NoAction, map: "Fato_Respostas_ibfk_4")

  @@unique([AlunoKey, QuestaoKey, SimuladoKey], map: "AlunoKey")
  @@index([AlunoKey], map: "IX_Fato_Aluno")
  @@index([QuestaoKey], map: "IX_Fato_Questao")
  @@index([SimuladoKey], map: "IX_Fato_Simulado")
  @@index([TempoKey], map: "IX_Fato_Tempo")
}

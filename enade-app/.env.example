# Copie para .env.local e preencha. Não commite o .env.local.
# SSL é obrigatório no MySQL da Aiven. O Prisma usa sslaccept (não ssl-mode).

DATABASE_URL="mysql://USUARIO:SENHA@HOST:PORTA/defaultdb?sslaccept=accept_invalid_certs&connection_limit=5&connect_timeout=20"

# Supabase Auth — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# E-mails que viram ADMIN no login (separados por vírgula). Não rebaixa quem já é admin.
ADMIN_EMAILS=

# Provedores sociais habilitados no painel do Supabase. Padrão: google,github
NEXT_PUBLIC_AUTH_PROVIDERS=google,github

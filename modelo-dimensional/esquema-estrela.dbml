// ENADE Analytics — esquema estrela (Kimball)
// Grão: 1 resposta × 1 aluno anônimo × 1 questão × 1 aplicação
// Importar em https://dbdiagram.io

Table Dim_Tempo {
  TempoKey integer [pk]
  Data date [unique, not null]
  Ano integer [not null]
  Mes integer [not null]
  NomeMes varchar [not null]
  SemanaSemestre integer [not null]
}

Table Dim_Aluno_Anonimo {
  AlunoKey integer [pk]
  CodigoAlunoAnonimo varchar [unique, not null, note: 'Ex.: Aluno_014 — sem PII']
  TurmaGrupo varchar [not null]
}

Table Dim_Questao {
  QuestaoKey integer [pk]
  CodigoQuestao varchar [unique, not null]
  EixoTematico varchar [not null, note: 'Portaria Inep 171/2026 Art. 6º — 16 eixos']
  NivelDificuldade varchar [not null, note: 'Fácil | Médio | Difícil']
  Enunciado varchar [note: 'Texto da pergunta no simulado']
}

Table Dim_Simulado {
  SimuladoKey integer [pk]
  CodigoSimulado varchar [unique, not null]
  NumeroAplicacao integer [not null]
  DescricaoSimulado varchar [not null]
}

Table Fato_Respostas {
  RespostaKey integer [pk]
  TempoKey integer [not null, ref: > Dim_Tempo.TempoKey]
  AlunoKey integer [not null, ref: > Dim_Aluno_Anonimo.AlunoKey]
  QuestaoKey integer [not null, ref: > Dim_Questao.QuestaoKey]
  SimuladoKey integer [not null, ref: > Dim_Simulado.SimuladoKey]
  RespostaDada varchar [not null]
  Acertou integer [not null, note: 'Contador aditivo 0/1 — taxa = SUM/COUNT']
  TempoRespostaSegundos integer
}

Table Alternativa {
  AlternativaKey integer [pk]
  QuestaoKey integer [not null, ref: > Dim_Questao.QuestaoKey]
  Letra varchar [not null, note: 'A a E']
  Texto varchar [not null]
  Correta integer [not null, note: '1 só na resposta correta']
}

Table Simulado_Questao {
  SimuladoKey integer [not null, ref: > Dim_Simulado.SimuladoKey]
  QuestaoKey integer [not null, ref: > Dim_Questao.QuestaoKey]
  indexes {
    (SimuladoKey, QuestaoKey) [pk]
  }
}

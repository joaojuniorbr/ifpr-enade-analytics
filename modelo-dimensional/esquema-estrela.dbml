// ENADE Analytics — Guia Semana 7 (Unidade 3)
// Importar em https://dbdiagram.io

Table Dim_Dificuldade {
  DificuldadeKey integer [pk]
  Nivel varchar [unique, not null, note: 'Fácil | Médio | Difícil']
}

Table Dim_Turma {
  TurmaKey integer [pk]
  TurmaGrupo varchar [unique, not null, note: 'Sem nome de estudante']
}

Table Dim_Tempo {
  TempoKey integer [pk]
  Data date [unique, not null]
  NumeroSimulado integer [not null, note: 'Simulado nº']
  CodigoSimulado varchar [unique, not null]
  DescricaoSimulado varchar [not null]
  Ano integer [not null]
  Mes integer [not null]
  NomeMes varchar [not null]
  SemanaSemestre integer [not null]
}

Table Dim_Questao_Eixo {
  QuestaoEixoKey integer [pk]
  CodigoQuestao varchar [unique, not null]
  EixoTematico varchar [not null, note: '16 eixos — Portaria Inep 171/2026']
  Enunciado varchar
  DificuldadeKey integer [not null, ref: > Dim_Dificuldade.DificuldadeKey]
}

Table Dim_Aluno_Anonimo {
  AlunoKey integer [pk]
  CodigoAlunoAnonimo varchar [unique, not null, note: 'Drill-down interno — ocultar na coordenação']
  TurmaKey integer [not null, ref: > Dim_Turma.TurmaKey]
}

Table Fato_Respostas {
  RespostaKey integer [pk]
  TempoKey integer [not null, ref: > Dim_Tempo.TempoKey]
  QuestaoEixoKey integer [not null, ref: > Dim_Questao_Eixo.QuestaoEixoKey]
  DificuldadeKey integer [not null, ref: > Dim_Dificuldade.DificuldadeKey]
  TurmaKey integer [not null, ref: > Dim_Turma.TurmaKey]
  AlunoKey integer [not null, ref: > Dim_Aluno_Anonimo.AlunoKey]
  RespostaDada varchar [not null]
  Acertou integer [not null, note: '0/1 aditivo']
  TempoRespostaSegundos integer
}
